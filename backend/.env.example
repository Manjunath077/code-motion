# Groq free tier only (temporary — replaced by OpenRouter in NEW_PLAN.md step 2). Get a key at console.groq.com
GROQ_API_KEY=

LLM_TEMPERATURE=0.3
LLM_TIMEOUT=30

# Port 5433, not 5432 — a native PostgreSQL install may already own 5432 on this machine.
DATABASE_URL=postgresql+asyncpg://code_motion:code_motion@localhost:5433/code_motion

REDIS_URL=redis://localhost:6379/0
MEDIA_DIR=media
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:5173"]
