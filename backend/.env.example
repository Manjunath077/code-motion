# OpenRouter, free models only (see NEW_PLAN.md Section 4).
# Use a DEDICATED key for this project with a $1 credit limit — never a key
# shared with another app. Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Every model ID must end in ":free" or the app refuses to boot.
MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_VL=nvidia/nemotron-3.5-super-vl:free
MODEL_LIGHTNING=nvidia/nemotron-3.5-lightning:free

LLM_RPM=18
LLM_DAILY_RESERVE=50
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120

# Port 5433, not 5432 — a native PostgreSQL install may already own 5432 on this machine.
DATABASE_URL=postgresql+asyncpg://code_motion:code_motion@localhost:5433/code_motion

REDIS_URL=redis://localhost:6379/0
MEDIA_DIR=media
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:5173"]
